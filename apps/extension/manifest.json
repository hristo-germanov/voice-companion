{
  "manifest_version": 3,
  "name": "ChatGPT Voice Companion",
  "version": "0.1.0",
  "description": "Capture ChatGPT messages and forward them to a local reader.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["dom-adapter.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
